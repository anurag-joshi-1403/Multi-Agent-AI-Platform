# Copy this file to .env and fill in your own values. .env is ignored by git; this file is not,
# so never put a real key here.
# Read at startup through spring.config.import in application.properties.

# AI providers: set a key for at least one; leave the rest empty. Each one with a key is tried in
# AI_PROVIDERS order, and when one fails the next one answers.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: a different order (empty = groq,openrouter,google-genai,openai,anthropic)
AI_PROVIDERS=

# MongoDB for console accounts (sign-up + login). Local install, no password:
MONGODB_URI=mongodb://localhost:27017/agents

# Sign-up invite code. Empty = anyone who can reach the console may sign up; set one before
# others can reach it, and give it only to the people you invite.
SIGNUP_INVITE_CODE=

# HTTPS - both off by default (see application.properties). Remove the # to switch one on.
# a) Behind an HTTPS reverse proxy on this machine or a private network:
#FORWARD_HEADERS_STRATEGY=native
# b) Spring Boot serves HTTPS itself, from a PKCS12 keystore:
#SSL_ENABLED=true
#SSL_KEY_STORE=file:C:/certs/console.p12
#SSL_KEY_STORE_PASSWORD=
# Who may connect: unset = this machine only (127.0.0.1). Open it up only with HTTPS and an invite code:
#SERVER_ADDRESS=0.0.0.0
