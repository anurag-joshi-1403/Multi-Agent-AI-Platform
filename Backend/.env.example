# Copy this file to .env and fill in your own values. .env is ignored by git; this file is not,
# so never put a real key here.
# Read at startup through spring.config.import in application.properties.

# AI providers: set a key for at least one; leave the rest empty. Each one with a key is tried in
# AI_PROVIDERS order, and when one fails the next one answers.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: a different order (empty = groq,openrouter,google-genai,openai,anthropic)
AI_PROVIDERS=

# Console accounts: comma-separated username:password pairs, e.g. anna:a-long-password,ben:another-one
# Leave empty to get a one-time "admin" password in the backend log instead.
AUTH_USERS=
